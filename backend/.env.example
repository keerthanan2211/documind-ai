# PostgreSQL with the pgvector extension
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind

# Google Gemini: get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# File storage: "local" (folder on disk) or "s3"
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads
S3_BUCKET=
AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are read by boto3 from the environment

# Limits
MAX_UPLOAD_MB=20
MAX_PAGES=300

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000
MAX_DISTANCE=0.75
